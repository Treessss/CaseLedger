# Flask配置
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here

# JWT 签名密钥（务必使用强随机值，可用: python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET_KEY=your-jwt-secret-key-here
# 登录后免登录时长（小时）。168 = 7 天；越短越安全，公网环境建议 12~24
JWT_EXPIRES_HOURS=168

# 平台账号密码加密密钥（Fernet key，生成方式:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
# 注意：该密钥不可随意更换，否则已有密码数据将无法解密（需配合 migrate_encryption_key.py 迁移）
ENCRYPTION_KEY=your-fernet-key-here

# 管理员账号（不要使用历史默认值 admin/qweasdzxc，该值已公开）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# 更安全的做法：使用哈希代替明文密码
# 生成: python -c "from werkzeug.security import generate_password_hash;print(generate_password_hash('你的密码'))"
# ADMIN_PASSWORD_HASH=

# 登录失败限流
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# 是否把异常细节返回给前端（生产环境必须为 False）
EXPOSE_ERROR_DETAILS=False

# Zoho Mail（客服邮件模块）：在 Zoho API Console 建 Self Client 后填这里。
# 邮箱的 refresh token 和 DeepSeek Key 都加密存在数据库里，不进 .env。
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# 允许跨域访问的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:8002,http://127.0.0.1:8002

# 数据库配置
# 生产环境（推荐）：PostgreSQL
#   python migrate_to_postgres.py 可把现有 SQLite 数据迁到 PostgreSQL
DATABASE_URL=postgresql://caseledger:your-strong-password@127.0.0.1:5432/caseledger
# 本地开发可改用 SQLite（留空或使用下面这行）：
# DATABASE_URL=sqlite:////absolute/path/to/instance/caseLedger.db

# 连接池（仅 PostgreSQL/MySQL 生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# SQLite 并发设置（仅 SQLite 生效）
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=30000

# Shopify API配置
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_SHOP_URL=your-shop.myshopify.com
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# 客户隐私数据（姓名 / 收货地址 / 电话）专用凭据。
#
# 店铺后台「设置 → 应用 → 开发应用」自建的应用，签发的是永久 shpat_ 令牌，
# Shopify 不把 PII 给它（会报 "not approved to access the Customer object"）。
# 客户姓名、收货地址、电话必须用已获批 PII 权限的 Partner 应用换取临时令牌，
# 也就是扫码查单工具在用的那套应用（grant_type=client_credentials）。
#
# 留空则回退使用 SHOPIFY_ACCESS_TOKEN（拿不到 PII，订单详情只有国家/省份）。
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=

# 汇率：主源 + 独立备用源；两者失败时最多使用 7 天内最后一次成功报价。
# 不再使用固定的 USD/CNY=7.2、HKD/CNY=0.923 作为静默兜底。
EXCHANGE_RATE_REQUEST_TIMEOUT=10
EXCHANGE_RATE_MAX_STALE_DAYS=7
# 多实例部署时可指定共享、持久化路径；单实例默认在本项目 instance/exchange_rates.json。
# EXCHANGE_RATE_CACHE_PATH=/absolute/path/exchange_rates.json

# PayPal API配置
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Stripe API配置
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Redis配置（用于Celery）
# Celery 的 broker + 结果后端。
# 注意：同一台机器上如果还跑着别的 CaseLedger 实例，务必用不同的库号（/10、/11…），
# 否则两个实例的队列名和任务名完全相同，会把任务互相消费掉。
# 这个项目固定用 /10，不要改成 /0。
REDIS_URL=redis://localhost:6379/10

# 服务器配置
HOST=127.0.0.1
PORT=5000
